<Project Sdk="Microsoft.NET.Sdk">
  <!-- Microsoft's OData libraries reading Vectro's feed: the CSDL parser
       (Microsoft.OData.Edm) and Simple.OData.Client (on Microsoft.OData.Core) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>odatacheck</AssemblyName>
    <RootNamespace>OdataCheck</RootNamespace>
    <NoWarn>NU1903;NU1902;NU1608</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Simple.OData.Client" Version="6.0.1" />
    <PackageReference Include="Microsoft.OData.Core" Version="7.10.0" />
    <PackageReference Include="Microsoft.OData.Edm" Version="7.10.0" />
    <PackageReference Include="Microsoft.Spatial" Version="7.10.0" />
  </ItemGroup>
</Project>
