    "title": "Live sync compared: from a change to the client having the new answer (same orders, same query, same changes)",
    "scripts": "bench/bench-live.mjs (Vectro), compare/live-rivals/bench-hasura.mjs, compare/live-rivals/bench-firestore.mjs",
    "date": "2026-11-08",
