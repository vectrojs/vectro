     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT region, SUM(qty * unit_price * (1 - COALESCE(discount, 0))) AS revenue FROM orders WHERE $__timeFilter(ts) GROUP BY region ORDER BY revenue DESC"
    }
