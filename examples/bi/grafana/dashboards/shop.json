  {
   "type": "table",
   "title": "Top products",
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 14,
    "h": 9
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "vectro"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "vectro"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT p.product, p.category, COUNT(*) AS orders, ROUND(SUM(o.qty * o.unit_price * (1 - COALESCE(o.discount, 0))), 0) AS revenue, ROUND(SUM(o.qty * (o.unit_price - p.unit_cost)), 0) AS margin FROM orders o JOIN products p ON o.product_id = p.product_id WHERE $__timeFilter(o.ts) GROUP BY 1, 2 ORDER BY revenue DESC LIMIT 10"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Weekly orders, 4-week moving average",
   "gridPos": {
    "x": 14,
    "y": 14,
    "w": 10,
    "h": 9
   },
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "vectro"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "vectro"
     },
     "rawQuery": true,
     "editorMode": "code",
     "format": "time_series",
     "rawSql": "SELECT \"time\", orders, AVG(orders) OVER (ORDER BY \"time\" ROWS BETWEEN 3 PRECEDING AND CURRENT ROW) AS moving_avg FROM (SELECT $__timeGroupAlias(ts, '7d'), COUNT(*) AS orders FROM orders WHERE $__timeFilter(ts) GROUP BY 1) w ORDER BY 1"
    }
   ]
  }
