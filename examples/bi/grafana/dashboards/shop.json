     "rawSql": "SELECT $__timeGroupAlias(ts, '1d'), channel AS metric, SUM(qty * unit_price * (1 - COALESCE(discount, 0))) AS revenue FROM orders WHERE $__timeFilter(ts) GROUP BY 1, 2 ORDER BY 1"
